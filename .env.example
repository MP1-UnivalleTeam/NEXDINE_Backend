# ==========================================================
# NEXDINE Backend: variables de entorno
# ==========================================================
# Copia este archivo como .env SOLO para desarrollo local (está en .gitignore).
# En Render configura estas mismas variables en Environment.
# Los valores de abajo son ejemplos ficticios: NUNCA pongas aquí valores reales.

# --- Servidor ---------------------------------------------
# Render asigna PORT automáticamente; no lo definas allá.
PORT=8080

# --- Base de datos (Supabase PostgreSQL) ------------------
# Usa la cadena JDBC del "Session pooler" de Supabase.
# El backend se conecta como usuario de PostgreSQL; NO necesita
# SUPABASE_SERVICE_ROLE_KEY ni la anon key, y no deben configurarse.
SUPABASE_DB_URL=jdbc:postgresql://HOST_DE_SUPABASE:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.xxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=
# Debe quedarse en "validate" en producción (las migraciones las hace Flyway).
HIBERNATE_DDL_AUTO=validate

# --- CORS y sesión ----------------------------------------
# Dominios del frontend separados por coma, sin "/" final.
CORS_ALLOWED_ORIGINS=https://TU-PROYECTO.vercel.app
# En Render debe ser true: la cookie de sesión viaja entre dominios
# (vercel.app -> onrender.com) y el navegador exige Secure.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=none

# --- Documentación de la API (Swagger) --------------------
# false en producción para no publicar el mapa de la API.
SPRINGDOC_ENABLED=false

# --- Imágenes (Cloudinary) --------------------------------
# Si faltan, el backend arranca y la subida de imágenes responde 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nexdine/productos
APP_IMAGEN_MAX_BYTES=5242880
APP_IMAGEN_REQUEST_MAX_BYTES=6291456

# --- Pedidos ----------------------------------------------
APP_PEDIDOS_TASA_IMPUESTO=0
APP_ZONA_HORARIA=America/Bogota

# --- Pagos (Stripe) ---------------------------------------
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cop
STRIPE_TEST_MODE=true
STRIPE_DEPOSIT_PERCENT=30

# --- Correo (facturas, reembolsos, avisos, recordatorios) -
# Con Gmail usa una "contraseña de aplicación". Si faltan, los envíos responden 503.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_CORREO_REMITENTE=
