# Backend local
PORT=8080

# Supabase PostgreSQL
SUPABASE_DB_URL=jdbc:postgresql://HOST:5432/postgres
SUPABASE_DB_USER=postgres.xxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=TU_CONTRASEÑA

# CORS
# Local:
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Producción (Render):
# CORS_ALLOWED_ORIGINS=https://TU-PROYECTO.vercel.app

# ==========================================================
# CLOUDINARY (imágenes de productos)
# ==========================================================
# Se obtienen desde https://console.cloudinary.com/settings/api-keys
# NO subir el archivo .env real al repositorio.
# Si faltan estas variables el backend ARRANCA igual, pero la
# subida de imágenes por archivo responde HTTP 503 controlado.
CLOUDINARY_CLOUD_NAME=TU_CLOUD_NAME
CLOUDINARY_API_KEY=TU_API_KEY
CLOUDINARY_API_SECRET=TU_API_SECRET

# Carpeta destino de las imágenes (opcional).
# CLOUDINARY_FOLDER=nexdine/productos

# Límite de tamaño de la imagen en bytes (opcional, 5 MB por defecto).
# APP_IMAGEN_MAX_BYTES=5242880

# Cookies de sesión
# Local:
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# Producción:
# SESSION_COOKIE_SAME_SITE=none
# SESSION_COOKIE_SECURE=true
