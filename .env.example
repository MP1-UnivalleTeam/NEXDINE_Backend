# Backend local
PORT=8080

# Supabase PostgreSQL
SUPABASE_DB_URL=jdbc:postgresql://HOST:5432/postgres
SUPABASE_DB_USER=postgres.xxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=TU_CONTRASEÑA

# CORS
# Local:
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Producción (Render):
# CORS_ALLOWED_ORIGINS=https://TU-PROYECTO.vercel.app

# Cookies de sesión
# Local:
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# Producción:
# SESSION_COOKIE_SAME_SITE=none
# SESSION_COOKIE_SECURE=true
