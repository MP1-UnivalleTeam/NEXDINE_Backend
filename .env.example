# Puerto local (Render proporciona PORT automáticamente)
PORT=8080

# Supabase PostgreSQL
SUPABASE_DB_URL=jdbc:postgresql://HOST:5432/postgres
SUPABASE_DB_USER=postgres.xxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=TU_CONTRASEÑA

# CORS - Orígenes permitidos (separados por coma)
# Desarrollo:
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Producción: agrega aquí el dominio de Vercel, separado por coma.
